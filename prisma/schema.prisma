// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusTurno {
  ABERTO
  CONCLUIDO
  PAGO
  ERRO_PAGAMENTO
}

enum StatusPagamento {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHOU
  /// Dispensado manualmente pelo dono (ex.: extra pago por fora, antes de
  /// virar CLT) — nunca gerado pelo fluxo normal de pagamento. Para de
  /// contar como pendente (não entra em STATUS_PENDENTES), mas o valor
  /// original fica preservado no registro pra histórico/auditoria.
  CANCELADO
}

enum TipoDocumentoPessoa {
  CPF
  CNPJ
}

/// Tipo de vínculo da pessoa com a empresa — decide qual fluxo se aplica no
/// totem e nos relatórios. EXTRA é o comportamento de sempre (Turno +
/// Pagamento via PIX). CLT é controle interno de jornada (RegistroPonto),
/// sem cálculo de valor nem pagamento — ver docs/juridico e o disclaimer
/// nas telas voltadas pro CLT: isso NÃO é um registrador eletrônico de
/// ponto oficial (Portaria MTE 671/2021), é só controle interno.
enum TipoVinculo {
  EXTRA
  CLT
}

/// Turno fixo da pessoa (só relevante pra EXTRA) — usado pelo fechamento
/// automático pra decidir qual horário de corte aplicar quando ela
/// esquece de bater saída. LIVRE (padrão) deixa o sistema inferir pelo
/// horário de entrada — ver src/lib/turno.ts:classificarTurno.
enum TurnoPredefinido {
  MANHA
  NOITE
  LIVRE
}

/// Escala de trabalho do funcionário CLT — hoje é só informativo (aparece
/// no cadastro e no relatório de horas como referência). Não há comparação
/// automática contra o que foi de fato trabalhado nessa versão.
enum EscalaTrabalho {
  CINCO_X_DOIS
  SEIS_X_UM
  DOZE_X_TRINTA_E_SEIS
  OUTRA
}

/// Status de um RegistroPonto (bater ponto de funcionário CLT) — separado
/// de StatusTurno porque o ciclo de vida é mais simples (sem pagamento).
/// PENDENTE_CORRECAO é usado pelo fechamento automático quando ninguém
/// bateu a saída até o corte do dia — ver src/lib/fechamento-automatico.ts.
/// Diferente do Turno (que fecha sozinho com um horário inventado), aqui a
/// gente não inventa hora de saída de um registro de jornada.
enum StatusRegistroPonto {
  ABERTO
  CONCLUIDO
  PENDENTE_CORRECAO
}

enum TipoChavePix {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

/// Gênero informado no cadastro do Portal (iFREE Conecta) — ver
/// Pessoa.sexo. PREFIRO_NAO_DIZER é uma resposta explícita (diferente de
/// nunca ter respondido, que fica null).
enum Sexo {
  MASCULINO
  FEMININO
  PREFIRO_NAO_DIZER
}

/// Como a empresa trata o intervalo/pausa dentro de turnos longos —
/// NENHUMA mantém o comportamento de sempre (paga o turno inteiro).
/// AUTOMATICA_* desconta um intervalo fixo do cálculo em turnos acima de
/// 6h, sem exigir nenhuma ação da pessoa no totem (a alternativa, pausa
/// registrada manualmente, não tem incentivo pra ser usada de verdade —
/// ninguém bate uma pausa que reduz o próprio pagamento).
enum ModoPausa {
  NENHUMA
  AUTOMATICA_30
  AUTOMATICA_60
}

/// Como o freelancer é remunerado num vínculo específico com a empresa.
/// HORA é o padrão (valor/hora da função, arredondado por bloco de 5min).
/// DIARIA paga um valor fixo combinado com a pessoa, escalonado pelas
/// faixas de horas mínimas configuradas na empresa (ver
/// Empresa.diariaLimiarMeiaMin/diariaLimiarCompletaMin) — decisão de quem
/// habilita é sempre do dono, não da pessoa, pra evitar que ela escolha o
/// modo mais vantajoso caso a caso.
enum ModoPagamento {
  HORA
  DIARIA
}

/// Com que frequência a pessoa recebe o que ganhou — independente de como
/// o valor é calculado (ver ModoPagamento). DIARIA é o comportamento de
/// sempre (o Pagamento do turno já fica pronto assim que ele fecha).
/// SEMANAL acumula os turnos da semana (ver Empresa.semanaPagamentoInicioDia)
/// pra pagar tudo de uma vez no dia configurado (Empresa.semanaPagamentoDia).
enum FrequenciaPagamento {
  DIARIA
  SEMANAL
}

/// Agrupa empresas do mesmo dono (ex.: matriz + filiais) pra permitir
/// funcionário CLT flutuante entre elas (ver Empresa.grupoEconomicoId e
/// VinculoPessoaEmpresa.podeBaterPontoNoGrupo). Criado por quem já é
/// admin de todas as empresas envolvidas, em /empresas — nunca uma
/// entidade legal de verdade, só um agrupamento operacional dentro do
/// iFREE.
model GrupoEconomico {
  id       Int      @id @default(autoincrement())
  nome     String
  criadoEm DateTime @default(now())

  empresas Empresa[]
}

model Empresa {
  id                         Int       @id @default(autoincrement())
  nome                       String
  cnpj                       String
  /// E-mail de contato da empresa (diferente do e-mail de login do
  /// Usuario) — usado pra enviar cobranças e, futuramente, pra
  /// pré-preencher o e-mail de contato na hora de conectar a conta de
  /// pagamento (ver ContaAsaasForm).
  email                      String?
  endereco                   String?
  numero                     String?
  complemento                String?
  bairro                     String?
  cidade                     String?
  /// Só o CEP fica guardado (endereco/bairro/cidade já vêm resolvidos do
  /// autopreenchimento por CEP na hora do cadastro) — mesmo padrão de
  /// Pessoa.cep.
  cep                        String?
  /// Texto próprio do termo de aceite/contrato, editado em /configuracoes —
  /// null usa o texto padrão do sistema (src/lib/termos.ts). Mesma fonte
  /// pra tela de aceite do totem e pro PDF do contrato.
  termosContrato             String?
  /// Texto do regulamento interno, editado em /ged/regulamento — mesmo
  /// padrão de termosContrato (null usa o modelo padrão do sistema, ver
  /// REGULAMENTO_INTERNO_PADRAO em src/lib/ged.ts — modelo real cedido
  /// pelo Thiago, com nome/CNPJ da empresa substituídos dinamicamente).
  regulamentoInterno         String?   @db.Text
  /// Texto do contrato de trabalho CLT, editado em /ged/modelos — mesmo
  /// padrão de termosContrato (null usa o texto padrão do sistema, ver
  /// CONTRATO_CLT_TERMOS_PADRAO em src/lib/ged.ts), só que pro vínculo
  /// CLT em vez do totem EXTRA.
  contratoCltTermos          String?
  /// Desconto automático de intervalo pros EXTRAS, separado por turno do
  /// dia e da noite — turnos mais longos (ex.: noite de evento) costumam
  /// precisar de um intervalo diferente do turno do dia. Ver
  /// classificarTurno em src/lib/turno.ts pra saber qual dos dois vale pra
  /// cada turno. Config própria dos CLT logo abaixo (modoPausaCltDia/
  /// modoPausaCltNoite) — os dois fluxos não compartilham mais o mesmo
  /// valor, já que EXTRA e CLT têm lógicas de pagamento/jornada bem
  /// diferentes.
  modoPausaDia               ModoPausa @default(NENHUMA)
  modoPausaNoite             ModoPausa @default(NENHUMA)
  /// Faixas de horas (em minutos) que definem quanto da diária a pessoa
  /// recebe: abaixo de diariaLimiarMeiaMin paga metade, entre esse limiar
  /// e diariaLimiarCompletaMin paga 75%, a partir daí paga o valor cheio.
  diariaLimiarMeiaMin        Int       @default(240)
  diariaLimiarCompletaMin    Int       @default(360)
  /// Horário oficial de início de cada turno (minutos desde meia-noite,
  /// Brasília) — usado por classificarTurno (src/lib/turno.ts) pra
  /// classificar quem não tem turno fixo (LIVRE): o corte é o meio do
  /// caminho entre os dois inícios, não o fim do turno do dia (chegar
  /// bem antes do início da noite ainda conta como turno da noite, não
  /// do dia).
  horarioInicioDiaMin        Int       @default(540)  // 09:00
  horarioInicioNoiteMin      Int       @default(960)  // 16:00
  /// Horários (minutos desde meia-noite, horário de Brasília) usados como
  /// horaSaida quando o fechamento automático encerra um turno que ninguém
  /// bateu saída — ver src/lib/fechamento-automatico.ts. Qual dos dois se
  /// aplica depende da classificação do turno (ver
  /// src/lib/turno.ts:classificarTurno) ou de turnoDobrado.
  horarioFechamentoDiaMin    Int       @default(1020) // 17:00
  horarioFechamentoNoiteMin  Int       @default(1410) // 23:30
  /// Dia da semana (ISO: 1=segunda...7=domingo) em que a semana de
  /// pagamento começa — a semana fechada vai desse dia até 6 dias depois.
  /// Padrão segunda a domingo.
  semanaPagamentoInicioDia   Int       @default(1)
  /// Dia da semana (ISO: 1=segunda...7=domingo) em que os valores da
  /// semana fechada são pagos — pra quem está em frequência SEMANAL.
  /// Padrão quarta-feira.
  semanaPagamentoDia         Int       @default(3)
  /// Se funcionários CLT precisam bater o intervalo intrajornada no totem
  /// (entrada e saída do intervalo) — configuração única pra empresa toda,
  /// não por funcionário. false = só entrada/saída do dia. Quando ligado,
  /// o intervalo REAL batido pela pessoa sempre vence a estimativa abaixo
  /// (ver calcularMinutosPonto em src/lib/ponto.ts).
  funcionariosBaterIntervalo Boolean   @default(false)
  /// Desconto automático de intervalo pros CLT quando a pessoa não bate
  /// intervalo real no totem (ver funcionariosBaterIntervalo acima) —
  /// separado do desconto dos EXTRAS (modoPausaDia/modoPausaNoite) de
  /// propósito, já que é o mecanismo que cobre a exigência de intervalo
  /// intrajornada da CLT (art. 71) mesmo quando a empresa não faz a pessoa
  /// bater ponto disso. Padrão de 60min (1h) pros dois turnos — o mínimo
  /// mais comum na prática pra jornada acima de 6h.
  modoPausaCltDia            ModoPausa @default(AUTOMATICA_60)
  modoPausaCltNoite          ModoPausa @default(AUTOMATICA_60)
  /// Horário padrão (entrada/saída, minutos desde meia-noite Brasília) de
  /// cada escala CLT, um par pro turno da manhã e um pro turno da noite —
  /// null enquanto a empresa não configurou, e nesse caso não há
  /// comparação nenhuma (mesmo espírito informativo de sempre). OUTRA não
  /// tem padrão aqui de propósito — é a escala "não se encaixa em nenhum
  /// padrão fixo". Qual par vale pra cada pessoa depende de
  /// VinculoPessoaEmpresa.escalaTurno (null/MANHA usa os campos "Manha"
  /// abaixo, NOITE usa os "Noite"); VinculoPessoaEmpresa.horarioEntradaMin/
  /// horarioSaidaMin pode sobrescrever isso pra uma pessoa específica (ver
  /// src/lib/ponto.ts:horarioEsperadoClt).
  horarioEntrada5x2Min        Int?
  horarioSaida5x2Min          Int?
  horarioEntrada5x2NoiteMin   Int?
  horarioSaida5x2NoiteMin     Int?
  horarioEntrada6x1Min        Int?
  horarioSaida6x1Min          Int?
  horarioEntrada6x1NoiteMin   Int?
  horarioSaida6x1NoiteMin     Int?
  horarioEntrada12x36Min      Int?
  horarioSaida12x36Min        Int?
  horarioEntrada12x36NoiteMin Int?
  horarioSaida12x36NoiteMin   Int?
  /// Controle comercial — não afeta o totem, só o painel administrativo
  /// (ver requireTenant em src/lib/auth.ts). TRIAL/ATIVA liberam o painel;
  /// ATRASADA/CANCELADA bloqueiam — desde 2026-09-08 vale também pras
  /// próprias empresas do master (ele sempre pode se desbloquear na hora
  /// via /master/assinaturas, então nunca fica preso de verdade). Vira
  /// ATRASADA sozinho pelo cron diário quando assinaturaVenceEm passa (com
  /// folga de GRACA_DIAS, ver src/lib/assinatura.ts); volta pra ATIVA na
  /// hora que o webhook da Asaas confirma uma cobrança paga (ver
  /// AsaasCobrancaService em src/lib/cobranca/).
  statusAssinatura  StatusAssinatura @default(TRIAL)
  /// Fim do período de teste grátis, ou (depois de pago pela primeira vez)
  /// o próximo vencimento — sempre a mesma coluna, o significado muda
  /// conforme o status.
  assinaturaVenceEm DateTime?
  /// Com quantos dias de antecedência o aviso de renovação
  /// (AlertaAssinaturaVencendo, ver src/app/layout.tsx) começa a aparecer
  /// pro dono da empresa — escolhido por ele mesmo em /configuracoes
  /// (ver atualizarAvisoVencimentoDias em src/app/configuracoes/actions.ts).
  /// Só aceita 1, 3 ou 7 (ver AVISO_VENCIMENTO_OPCOES em
  /// src/lib/assinatura.ts); default 7 (mais folga) pra quem nunca mexeu.
  avisoVencimentoDias Int    @default(7)
  /// Liga/desliga o e-mail automático de saldo baixo na conta Asaas (ver
  /// verificarAlertasSaldoBaixo em src/lib/pagamentos/asaas-deposito.ts).
  alertaSaldoBaixoAtivo Boolean @default(false)
  /// Valor (R$) abaixo do qual dispara o aviso de saldo baixo — null
  /// enquanto nunca foi configurado (obrigatório preencher pra poder
  /// ativar, ver atualizarAlertaSaldoBaixo em src/app/configuracoes/
  /// actions.ts).
  alertaSaldoBaixoValorMinimo Decimal? @db.Decimal(10, 2)
  /// Quando o aviso GENÉRICO de saldo baixo foi enviado — null enquanto
  /// não enviado, ou depois que o saldo volta a ficar acima do mínimo
  /// (reseta pra poder avisar de novo na próxima queda, mesmo espírito de
  /// aprovacaoNotificadaEm em ContaAsaasEmpresa).
  alertaSaldoBaixoNotificadoEm DateTime?
  /// Quando o aviso ESPECIAL de sexta-feira foi enviado — comparado só
  /// pela data (nunca reseta com a recuperação do saldo, diferente do
  /// campo acima): evita mandar 2x no mesmo dia (o cron roda 2x/dia), mas
  /// permite mandar de novo na sexta seguinte se o saldo continuar baixo.
  alertaSaldoBaixoSextaNotificadoEm DateTime?
  /// Grupo de empresas do mesmo dono (ver GrupoEconomico) — permite que um
  /// funcionário CLT marcado como flutuante (VinculoPessoaEmpresa.
  /// podeBaterPontoNoGrupo) bata ponto em qualquer empresa deste mesmo
  /// grupo, sem precisar de vínculo próprio em cada uma. null = empresa
  /// avulsa, comportamento de sempre. Gerenciado em /empresas
  /// (salvarGrupoEconomico) por quem já é admin de todas as empresas
  /// envolvidas — nunca pelo master.
  grupoEconomicoId Int?
  grupoEconomico   GrupoEconomico? @relation(fields: [grupoEconomicoId], references: [id], onDelete: SetNull)
  /// Data do último uso da "liberação de confiança" (ver
  /// solicitarLiberacaoConfianca em src/app/assinatura/actions.ts) — 1x por
  /// mês (não por vida da empresa): só libera de novo quando já passou 1
  /// mês desde este valor. null = nunca usou.
  liberacaoConfiancaUsadaEm DateTime?
  /// Enquanto está no futuro, o painel funciona normalmente mesmo com
  /// statusAssinatura ATRASADA/CANCELADA — é a janela de 1 dia da liberação
  /// de confiança (ver requireTenant em src/lib/auth.ts e layout.tsx).
  /// Deliberadamente separado de assinaturaVenceEm/statusAssinatura: não
  /// mexe no ciclo de cobrança normal, só destrava o painel por cima
  /// temporariamente. null ou no passado = sem liberação ativa.
  liberacaoConfiancaAteEm   DateTime?
  /// Valor da mensalidade combinado com essa empresa — null usa o valor
  /// padrão (ver src/lib/assinatura.ts). Sem preço fixo em código porque
  /// cada negociação pode ser diferente.
  valorMensalidade  Decimal?         @db.Decimal(10, 2)
  /// Percentual (0 a 100) que a conta-mãe do iFREE retém via Split da Asaas
  /// toda vez que ESTA empresa deposita crédito na própria subconta (ver
  /// criarDepositoAsaas em src/lib/pagamentos/asaas-deposito.ts) — é a
  /// monetização em cima do volume de pagamentos automáticos. null ou 0 =
  /// sem split. Combinado individualmente por negociação com cada cliente
  /// (ver atualizarAssinaturaEmpresa em src/app/master/actions.ts), mesmo
  /// espírito de valorMensalidade acima.
  splitPercentualAsaas Decimal?       @db.Decimal(5, 2)
  /// Empresa recebeu um tablet fornecido pelo iFREE (equipamento físico
  /// pro totem), pago parcelado junto da mensalidade — controla se
  /// gerarCobrancaMensalidade (src/app/assinatura/actions.ts) deve
  /// embutir uma parcela extra na próxima cobrança. Ver
  /// tabletParcelasPagas/tabletParcelasTotal abaixo pro andamento.
  tabletFornecido      Boolean          @default(false)
  /// Valor total combinado do tablet — dividido em tabletParcelasTotal
  /// parcelas iguais (arredondadas pro centavo, sem tratamento especial
  /// de resto na última parcela, valor baixo não justifica). Varia por
  /// empresa (negociação individual), mesmo espírito de valorMensalidade.
  tabletValorTotal     Decimal?         @db.Decimal(10, 2)
  /// Em quantas parcelas (até 12, sem juros) o tablet está sendo cobrado.
  tabletParcelasTotal  Int?
  /// Quantas dessas parcelas já foram de fato PAGAS (incrementado só em
  /// confirmarCobrancaPaga, src/lib/assinatura.ts, quando o Pix daquele
  /// mês é confirmado — nunca na geração, pra não contar Pix gerado e
  /// nunca pago). Quando chega em tabletParcelasTotal, a mensalidade
  /// volta a cobrar só o valor normal.
  tabletParcelasPagas  Int              @default(0)
  /// ID do cliente Asaas (POST /v3/customers) representando ESTA empresa
  /// dentro da conta-mãe do iFREE — usado só pra cobrar a MENSALIDADE dela
  /// (ver AsaasCobrancaService em src/lib/cobranca/), sem nenhuma relação
  /// com ContaAsaasEmpresa.clienteProprioId (aquele é dentro da SUBCONTA da
  /// empresa, pro depósito de crédito pros extras — conta Asaas totalmente
  /// diferente). Criado uma vez, reaproveitado nas cobranças seguintes.
  clienteAsaasMensalidadeId String?
  /// Token do link público do Canal de Denúncias desta empresa
  /// (/denuncia/[token]) — nasce null e é gerado sob demanda na primeira
  /// visita à Central de Ética (mesmo idioma do token do Totem: aleatório,
  /// não sequencial, funciona como senha de acesso ao canal). Nullable
  /// pra não precisar de script de backfill pras empresas já existentes.
  tokenDenuncia     String?          @unique
  /// Prazo (dias corridos, a partir do recebimento) considerado dentro do
  /// SLA de tratativa de uma denúncia — usado só pro alerta "SLA vencido"
  /// na Central de Ética, ajustável em Configurações.
  slaDenunciaDias   Int              @default(30)
  /// Token do link público da pesquisa anônima do PGR (/pgr/[token]) —
  /// mesmo idioma de tokenDenuncia acima: nasce null, gerado sob demanda
  /// na primeira visita à tela de PGR, aleatório e não sequencial.
  tokenPgr          String?          @unique
  /// Quando a empresa aceitou os Termos de Uso e Política de Privacidade
  /// (/termos) — marcado na hora do cadastro (ver cadastrarNovaEmpresa em
  /// src/app/empresas/actions.ts), mesmo espírito de Pessoa.termosAceitosEm
  /// pro freelancer. Null pras empresas que já existiam antes deste campo
  /// existir (cadastradas antes de o aceite formal existir).
  termosAceitosEm   DateTime?
  criadoEm                   DateTime  @default(now())

  usuarios             UsuarioEmpresa[]
  funcoes              Funcao[]
  totens               Totem[]
  turnos               Turno[]
  registrosPonto       RegistroPonto[]
  vinculos             VinculoPessoaEmpresa[]
  sessoesAtivas        Sessao[]               @relation("EmpresaAtiva")
  cobrancasMensalidade CobrancaMensalidade[]
  vagas                Vaga[]
  conversas            Conversa[]
  denuncias            Denuncia[]
  gruposPagamento      GrupoPagamento[]
  contaAsaas           ContaAsaasEmpresa?
  depositosAsaas       DepositoAsaas[]
  documentosGed        DocumentoGed[]
  modelosDocumentoGed  ModeloDocumentoGed[]
  entradasEpi          EntradaEpi[]
  modelosPapelGed      ModeloPapelGed[]
  tentativasConfirmacaoIdentidade TentativaConfirmacaoIdentidade[]
  ciclosPgr            CicloPgr[]
  acoesPgr             AcaoPgr[]
  convitesEquipe       ConviteEquipe[]
}

enum StatusAssinatura {
  TRIAL
  ATIVA
  ATRASADA
  CANCELADA
}

enum StatusCobranca {
  PENDENTE
  PAGA
  EXPIRADA
  CANCELADA
}

/// Uma cobrança PIX avulsa de mensalidade — gerada sob demanda quando o
/// dono da empresa clica em "gerar PIX" (não é recorrência automática).
/// Diferente de Pagamento (que é 1 pagamento por Turno, saída de dinheiro
/// pros extras): aqui é entrada de dinheiro, N cobranças por empresa ao
/// longo do tempo.
model CobrancaMensalidade {
  id                 Int            @id @default(autoincrement())
  empresaId          Int
  valor              Decimal        @db.Decimal(10, 2)
  /// Parcela do tablet embutida NESTA cobrança específica (null = essa
  /// cobrança foi só mensalidade normal, sem tablet) — já está somada
  /// dentro de `valor` acima, este campo é só pra discriminar na tela
  /// depois. confirmarCobrancaPaga usa isto pra saber se incrementa
  /// Empresa.tabletParcelasPagas quando o Pix é confirmado.
  valorTablet        Decimal?       @db.Decimal(10, 2)
  /// "2026-08" — mês de competência, evita gerar duas cobranças pro mesmo
  /// mês se a pessoa clicar em "gerar PIX" mais de uma vez.
  referenciaMes      String
  status             StatusCobranca @default(PENDENTE)
  idTransacaoExterna String?
  /// Copia-e-cola do PIX.
  qrCode             String?
  qrCodeImagemUrl    String?
  expiraEm           DateTime
  pagoEm             DateTime?
  criadoEm           DateTime       @default(now())
  atualizadoEm       DateTime       @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, status])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  senhaHash    String
  nomeCompleto String?
  cpf          String?  @unique
  isMaster     Boolean  @default(false)
  /// Null enquanto a pessoa não clicou no link de confirmação enviado
  /// no cadastro — login fica bloqueado até confirmar (ver
  /// src/app/login/actions.ts). Contas já existentes antes deste campo
  /// existir foram marcadas como verificadas na migração, pra ninguém
  /// ficar bloqueado de uma hora pra outra.
  emailVerificadoEm DateTime?
  criadoEm     DateTime @default(now())

  empresas UsuarioEmpresa[]
  sessoes  Sessao[]
  tokensAutenticacao TokenAutenticacao[]
  convitesEquipeCriados ConviteEquipe[] @relation("ConvitesEquipeCriados")
  conviteEquipeUsado    ConviteEquipe[] @relation("ConviteEquipeUsado")
}

enum TipoTokenAutenticacao {
  VERIFICACAO_EMAIL
  RECUPERACAO_SENHA
  /// Só usado por TokenAutenticacaoPessoa (troca de e-mail já logado no
  /// Portal) — ver novoEmailPendente lá embaixo. Usuario não tem esse
  /// fluxo ainda, mas o enum é compartilhado entre as duas tabelas.
  TROCA_EMAIL
}

/// Token de uso único enviado por e-mail — confirmação de cadastro ou
/// recuperação de senha. Mesmo padrão de token aleatório já usado em
/// Sessao/Totem (randomBytes(32) em hex), só que de curta duração e
/// marcado como usado depois de consumido (nunca reaproveitável).
model TokenAutenticacao {
  id        Int                    @id @default(autoincrement())
  token     String                 @unique
  usuarioId Int
  tipo      TipoTokenAutenticacao
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime               @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
}

model UsuarioEmpresa {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  empresaId Int
  /// Marca quem enxerga a Central de Ética desta empresa — acesso
  /// restrito de propósito (diferente do resto do sistema, onde todo
  /// UsuarioEmpresa vê tudo), já que denúncia é dado confidencial. Quem
  /// já tinha acesso à empresa antes deste campo existir foi marcado como
  /// true na migração (ninguém perde acesso de surpresa); só logins novos
  /// daqui pra frente nascem sem a marcação.
  responsavelEtica Boolean @default(false)
  /// Marca quem enxerga o módulo GED (Gestão Eletrônica de Documentos)
  /// desta empresa — mesmo espírito de responsavelEtica (dado sensível
  /// de RH). Mesma regra de backfill: quem já tinha acesso à empresa foi
  /// marcado como true na migração, só logins novos nascem sem.
  responsavelGed Boolean @default(false)
  /// Marca quem enxerga o módulo PGR (riscos psicossociais, NR-1) desta
  /// empresa — mesmo espírito de responsavelEtica/responsavelGed. Mesma
  /// regra de backfill: quem já tinha acesso à empresa foi marcado como
  /// true na migração, só logins novos nascem sem.
  responsavelPgr Boolean @default(false)
  /// Módulos liberados pra este login nesta empresa (chaves de
  /// src/lib/modulosEquipe.ts — ex.: "funcionarios", "pagamentos",
  /// "financeiro") — diferente de responsavelEtica/Ged/Pgr acima (3
  /// telas sensíveis com flag própria cada), aqui é UM array cobrindo os
  /// módulos "normais" do menu (12 hoje), porque 12 colunas booleanas
  /// quase idênticas seria repetição real sem ganho nenhum sobre um
  /// array, e um módulo novo no futuro não pediria migração. Todo
  /// UsuarioEmpresa que já existia antes deste campo nascer foi
  /// preenchido com a lista completa na migração (tinha acesso total,
  /// ninguém pode perder acesso de surpresa) — só login novo criado
  /// depois (via convite, ver ConviteEquipe) nasce com a lista que o
  /// dono escolheu. Checado em requireModulo/usuarioTemModulo
  /// (src/lib/modulosEquipe.ts), que bloqueia de verdade no servidor
  /// (página E action), não só esconde do menu.
  modulosPermitidos String[] @default([])
  /// Pode gerenciar a equipe desta empresa (convidar gente nova, editar
  /// módulo de quem já tem acesso) — achado revisando o pedido do Thiago
  /// em 2026-09-22 (Bar Cabral): sem isso, QUALQUER login secundário,
  /// mesmo um com um módulo só liberado, conseguia entrar em /equipe e
  /// se autopromover, porque a página só checava "tem alguma
  /// UsuarioEmpresa" sem diferenciar dono de convidado. Todo
  /// UsuarioEmpresa que já existia antes deste campo nascer foi
  /// preenchido com true na migração (era exatamente o que cada um já
  /// podia fazer até aqui, ninguém perde acesso de surpresa); só quem
  /// entra via ConviteEquipe daqui pra frente nasce com false —
  /// coerente com o pedido de limitar financeiro/RH a só o que foi
  /// marcado. Checado em requireAdminEquipe/usuarioEhAdminEquipe
  /// (src/lib/adminEquipe.ts).
  admin Boolean @default(true)
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
}

/// Convite de acesso à equipe por link — o dono marca quais módulos
/// (src/lib/modulosEquipe.ts) a pessoa convidada vai ter e gera um link
/// pra compartilhar por fora do sistema (WhatsApp, e-mail); quem abre o
/// link define o próprio nome/e-mail/senha (ver resgatarConviteEquipe em
/// src/app/equipe/actions.ts), sem o dono precisar cadastrar nada antes.
/// Token de uso único com validade curta (7 dias) — diferente do padrão
/// "link de canal" (Empresa.tokenDenuncia/tokenPgr, permanente e
/// reutilizável à vontade), esse aqui cria uma conta de verdade, então
/// segue o mesmo padrão de TokenAutenticacao (expira, some depois de
/// usado uma vez).
model ConviteEquipe {
  id                Int       @id @default(autoincrement())
  empresaId         Int
  criadoPorId       Int
  token             String    @unique
  /// Mesmas chaves de UsuarioEmpresa.modulosPermitidos — copiado pro
  /// UsuarioEmpresa novo no momento do resgate.
  modulosPermitidos String[]
  expiraEm          DateTime
  usadoEm           DateTime?
  usadoPorId        Int?
  /// Dono cancelou um convite ainda não resgatado (link enviado errado,
  /// por exemplo) — convite revogado nunca mais pode ser resgatado,
  /// mesma checagem de expiraEm/usadoEm em buscarConviteValido.
  revogadoEm        DateTime?
  criadoEm          DateTime  @default(now())

  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPor Usuario  @relation("ConvitesEquipeCriados", fields: [criadoPorId], references: [id], onDelete: Cascade)
  usadoPor  Usuario? @relation("ConviteEquipeUsado", fields: [usadoPorId], references: [id], onDelete: SetNull)

  @@index([empresaId])
}

model Sessao {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  usuarioId      Int
  empresaAtivaId Int?
  /// Empresa que o MASTER escolheu acessar mesmo com assinatura
  /// ATRASADA/CANCELADA (botão "Entrar mesmo assim" em /assinatura, ver
  /// entrarMesmoBloqueado em src/app/assinatura/actions.ts) — só produz
  /// efeito quando o usuário desta sessão é master (checado em
  /// requireTenant, src/lib/auth.ts); pro dono normal da empresa não tem
  /// nenhum efeito, ele usa a liberação de confiança (mecanismo
  /// completamente diferente, ver Empresa.liberacaoConfiancaUsadaEm).
  /// Não precisa expirar sozinho: só é consultado quando bate com a
  /// empresa efetiva da sessão.
  masterBypassEmpresaId Int?
  criadoEm       DateTime @default(now())
  expiraEm       DateTime

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaAtiva Empresa? @relation("EmpresaAtiva", fields: [empresaAtivaId], references: [id], onDelete: SetNull)
}

/// Totem físico (tablet). Token próprio por dispositivo p/ poder revogar
/// um tablet perdido/roubado sem afetar os outros.
model Totem {
  id        Int      @id @default(autoincrement())
  empresaId Int
  nome      String
  token     String   @unique
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  turnos         Turno[]
  registrosPonto RegistroPonto[]
}

/// Registro global da pessoa física — a mesma pessoa pode trabalhar p/
/// múltiplas empresas, então não é escopado por tenant.
model Pessoa {
  id            Int                 @id @default(autoincrement())
  documento     String              @unique
  tipoDocumento TipoDocumentoPessoa @default(CPF)
  nome          String
  telefone      String
  endereco      String
  numero        String?
  complemento   String?
  bairro        String?
  /// Obrigatória só pro caminho EXTRA (pago por PIX) — funcionário CLT não
  /// tem valor calculado, então não precisa de chave PIX. Validação de
  /// obrigatoriedade acontece na camada de aplicação, não no schema.
  chavePix      String?
  tipoChavePix  TipoChavePix?
  /// Foto mais recente do CHECK-IN NO TOTEM (ver fotoEntradaUrl em Turno) —
  /// sobrescrita a cada turno novo, guardada aqui só como referência
  /// interna pra conferência rápida de identidade (ex.: painel master),
  /// NUNCA como avatar apresentável pra empresa/dono. Não confundir com
  /// fotoPerfilUrl abaixo.
  fotoUrl       String?
  /// Foto de perfil escolhida pela própria pessoa no cadastro/edição do
  /// Portal (iFREE Conecta) — a ÚNICA foto que deve aparecer como avatar
  /// pra empresa (freelancers, painel) ou em contexto de Conecta (vagas,
  /// candidatos, currículo). Null pra quem nunca passou pelo Portal.
  fotoPerfilUrl String?
  /// Respondido no cadastro do Portal (iFREE Conecta) — só usado hoje pra
  /// colorir o avatar padrão (azul/rosa/cinza) quando a pessoa ainda não
  /// tem fotoPerfilUrl. Null pra quem nunca passou pelo cadastro do
  /// Conecta (extra que só usa o totem, sem conta no Portal) — nesse caso
  /// o avatar cai no mesmo cinza neutro de "prefiro não dizer".
  sexo          Sexo?
  /// Campos de contato adicionais, opcionais, preenchidos manualmente pelo
  /// dono em /freelancers/[id] ou /funcionarios/[id] — não fazem parte do
  /// autocadastro pelo totem.
  email                     String?
  rg                        String?
  /// CTPS (Carteira de Trabalho) — documento único da pessoa, usado
  /// principalmente na carta de advertência disciplinar do CLT (ver
  /// src/lib/advertencia-pdf.tsx). Opcional até ser preciso de verdade
  /// (gerar a carta é que exige os dois preenchidos).
  ctpsNumero                String?
  ctpsSerieUf               String?
  /// PIS/PASEP/NIT — documento único da pessoa (o número é o mesmo,
  /// independente do nome que a Caixa/INSS usa em cada época). Obrigatório
  /// pra quem é CLT em qualquer empresa (validado na camada de aplicação,
  /// não aqui — CTPS acima é o exemplo de opcional, este é exigido de
  /// verdade em criarFuncionario/atualizarDadosFuncionario).
  pisPasepNit               String?
  dataNascimento            DateTime? @db.Date
  cep                       String?
  cidade                    String?
  contatoEmergenciaNome     String?
  contatoEmergenciaTelefone String?
  /// Null enquanto a pessoa nunca configurou acesso ao Portal (iFREE
  /// Conecta, Fase 2) — só existe login pra quem passou pelo fluxo de
  /// verificação de e-mail em /portal/cadastrar-acesso. Nunca gravado
  /// direto por um formulário público (ver TokenAutenticacaoPessoa).
  senhaHash     String?
  /// Perfil profissional preenchido pela própria pessoa no Portal — usado
  /// pro checklist de completude (src/lib/perfil-completude.ts) e pro
  /// currículo em PDF (src/lib/curriculo-pdf.tsx). habilidades/vagasDesejadas
  /// são texto livre com sugestões na UI (src/lib/habilidades.ts), não um
  /// vocabulário fechado como Avaliacao.tags.
  biografia      String?  @db.Text
  habilidades    String[] @default([])
  vagasDesejadas String[] @default([])
  /// Como a pessoa costuma chegar no trabalho — importa pra empresa saber
  /// se ela consegue cumprir turno de madrugada/fim de linha de ônibus.
  /// Vocabulário fechado (src/lib/transporte.ts), igual a Avaliacao.tags.
  meiosTransporte String[] @default([])
  /// Opt-in explícito pro quadro de vagas (iFREE Conecta) — só quem liga
  /// isso no Portal vê e se candidata a vagas publicadas por empresas.
  /// Default false: ninguém fica visível/participando sem pedir.
  disponivelParaOportunidades Boolean @default(false)
  /// Null até a pessoa aceitar os Termos de Uso do Portal (uma vez só, sem
  /// versionamento por enquanto) — gate em requirePessoaComTermosAceitos
  /// (src/lib/auth-pessoa.ts), tela em /portal/termos.
  termosAceitosEm DateTime?
  /// Quem indicou esta pessoa a usar o iFREE Conecta — setado
  /// automaticamente quando o cadastro veio por um link de indicação
  /// (?ref=<pessoaId> em /portal/cadastro, ver criarCadastroPortal), nunca
  /// editável depois. É a fonte confiável de indicação (ver indicados
  /// abaixo, contado em src/lib/indicacao.ts) — indicadoPorNomeTexto logo
  /// abaixo é só um texto livre informativo, sem crédito automático (evita
  /// alguém inflar a própria contagem digitando qualquer nome sem ter
  /// vindo pelo link de verdade).
  indicadoPorPessoaId Int?
  /// Nome de quem indicou, digitado à mão no cadastro — só preenchido
  /// quando a pessoa respondeu "sim" à pergunta mas NÃO veio por um link
  /// de indicação (?ref=). Puramente informativo, não gera crédito.
  indicadoPorNomeTexto String?
  criadoEm      DateTime            @default(now())

  vinculos                 VinculoPessoaEmpresa[]
  turnos                   Turno[]
  registrosPonto           RegistroPonto[]
  sessoes                  SessaoPessoa[]
  tokensAutenticacao       TokenAutenticacaoPessoa[]
  candidaturas             Candidatura[]
  conversas                Conversa[]
  denuncias                Denuncia[]
  gruposPagamento          GrupoPagamento[]
  indicadoPor              Pessoa?                   @relation("Indicacoes", fields: [indicadoPorPessoaId], references: [id], onDelete: SetNull)
  indicados                Pessoa[]                  @relation("Indicacoes")
  documentosGed            DocumentoGed[]
  entradasEpi              EntradaEpi[]
  tentativasConfirmacaoIdentidade TentativaConfirmacaoIdentidade[]
}

/// Sessão de login da Pessoa no Portal (iFREE Conecta) — deliberadamente
/// separada de Sessao (login do dono/Usuario): mesmo espírito de manter
/// Turno/RegistroPonto sempre em tabelas próprias neste projeto. Zero
/// risco de qualquer mudança aqui afetar o login do dono.
model SessaoPessoa {
  id       Int      @id @default(autoincrement())
  token    String   @unique
  pessoaId Int
  expiraEm DateTime
  criadoEm DateTime @default(now())

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
}

/// Token de uso único (verificação de e-mail ou recuperação de senha) pro
/// login da Pessoa no Portal — espelha TokenAutenticacao (Usuario), mesmo
/// enum TipoTokenAutenticacao, tabela própria pelo mesmo motivo de
/// SessaoPessoa acima.
model TokenAutenticacaoPessoa {
  id       Int                   @id @default(autoincrement())
  token    String                @unique
  pessoaId Int
  tipo     TipoTokenAutenticacao
  /// Só preenchido quando tipo = TROCA_EMAIL — o novo e-mail fica pendente
  /// aqui, não em Pessoa.email, até a pessoa clicar no link recebido
  /// justamente NESSE endereço (prova que ela tem acesso à caixa de
  /// entrada nova antes de a troca valer de verdade).
  novoEmailPendente String?
  expiraEm DateTime
  usadoEm  DateTime?
  criadoEm DateTime              @default(now())

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([pessoaId, tipo])
}

/// Vínculo da pessoa numa empresa específica — criado automaticamente no
/// primeiro check-in bem-sucedido naquele totem (EXTRA) ou manualmente pelo
/// dono em /funcionarios (CLT).
model VinculoPessoaEmpresa {
  id                     Int                 @id @default(autoincrement())
  pessoaId               Int
  empresaId              Int
  ativo                  Boolean             @default(true)
  /// EXTRA (padrão, comportamento de sempre) ou CLT (controle interno de
  /// jornada, sem pagamento) — decide o fluxo no totem e nos relatórios.
  tipoVinculo            TipoVinculo         @default(EXTRA)
  /// Modo de pagamento dessa pessoa NESTA empresa — configurado pelo dono
  /// em /freelancers/[id], não pela pessoa no totem. Só se aplica a EXTRA.
  modoPagamento          ModoPagamento       @default(HORA)
  /// Valor fixo da diária combinado com a pessoa — obrigatório quando
  /// modoPagamento é DIARIA, ignorado (deve ficar null) quando é HORA.
  valorDiaria            Decimal?            @db.Decimal(10, 2)
  /// Com que frequência essa pessoa recebe NESTA empresa — configurado
  /// pelo dono, igual ao modoPagamento.
  frequenciaPagamento    FrequenciaPagamento @default(DIARIA)
  /// Salário mensal combinado — só se aplica a CLT, informativo (não gera
  /// pagamento nenhum pelo sistema).
  salarioMensal          Decimal?            @db.Decimal(10, 2)
  /// Escala de trabalho — só se aplica a CLT, campo de referência exibido
  /// no cadastro e no relatório de horas, sem comparação automática.
  escalaTrabalho         EscalaTrabalho?
  /// Qual dos dois horários-padrão da escala (manhã ou noite, configurados
  /// em Empresa.horarioEntrada5x2Min e afins) vale pra esta pessoa CLT —
  /// null/MANHA usa o par da manhã, NOITE usa o par da noite. LIVRE não
  /// tem sentido aqui (é valor do turnoPredefinido do EXTRA, reaproveitado
  /// só pelo tipo do enum) — a UI de funcionário só oferece Manhã/Noite.
  escalaTurno            TurnoPredefinido?
  /// Carga horária semanal esperada, em minutos — opcional pros dois tipos
  /// de vínculo (CLT e EXTRA). Não afeta pagamento nem cálculo nenhum do
  /// turno/ponto em si; é só a meta usada pra comparar contra o que foi
  /// trabalhado de verdade no resumo semanal/mensal (ver
  /// src/lib/resumo-horas.ts) e sinalizar hora extra ou hora a menos.
  cargaHorariaSemanalMin Int?
  /// Horário específico desta pessoa (minutos desde meia-noite Brasília) —
  /// só CLT. Null usa o padrão da escala configurado na empresa (ver
  /// Empresa.horarioEntrada5x2Min e afins); preenchido, sobrescreve o
  /// padrão só pra esta pessoa (ex.: alguém na mesma escala 6x1 mas que
  /// entra num horário diferente do resto da equipe).
  horarioEntradaMin      Int?
  horarioSaidaMin        Int?
  /// Intervalo específico desta pessoa — só CLT. Null usa o padrão da
  /// empresa (Empresa.modoPausaCltDia/modoPausaCltNoite, conforme o turno
  /// do dia); preenchido, sobrescreve o padrão só pra esta pessoa. Mesmo
  /// espírito de horarioEntradaMin/horarioSaidaMin acima.
  modoPausaOverride      ModoPausa?
  /// Data de admissão CLT — base do cálculo de período aquisitivo/concessivo
  /// de férias (ver src/lib/ferias.ts). Só se aplica a CLT.
  dataAdmissao           DateTime?           @db.Date
  /// Cargo registrado no contrato de trabalho — só CLT. Junto com
  /// Pessoa.ctpsNumero/ctpsSerieUf, é exigido pra gerar a carta de
  /// advertência disciplinar (ver src/lib/advertencia-pdf.tsx); fora
  /// disso é só informativo.
  cargo                  String?
  /// Matrícula interna do funcionário nesta empresa — obrigatória pra
  /// quem é CLT (validado em criarFuncionario/atualizarSalarioEscala, não
  /// aqui). Por empresa, não pela pessoa: a mesma pessoa pode ter
  /// matrículas diferentes em cada lugar onde trabalha.
  matriculaInterna       String?
  /// Data da última vez que a pessoa efetivamente tirou férias — reinicia a
  /// contagem do período aquisitivo. Null enquanto nunca tirou desde a
  /// admissão.
  ultimasFeriasGozadasEm DateTime?           @db.Date
  /// Quantidade de dias tirados na última vez que registrou férias — junto
  /// com ultimasFeriasGozadasEm acima, dá a data de retorno esperada (ver
  /// calcularFeriasEmAndamento em src/lib/ferias.ts). Null enquanto nunca
  /// registrou, ou quando só a data de admissão/ciclo foi ajustada na mão.
  feriasQuantidadeDias   Int?
  /// Adicionais e benefícios CLT — todos valor livre em R$, informativos
  /// (sem cálculo automático por percentual). Grava null quando o
  /// respectivo "recebe" está desmarcado.
  recebeInsalubridade        Boolean  @default(false)
  valorInsalubridade         Decimal? @db.Decimal(10, 2)
  recebePericulosidade       Boolean  @default(false)
  valorPericulosidade        Decimal? @db.Decimal(10, 2)
  /// Benefício de transporte — a classificação legal depende do desconto:
  /// se desconta os 6% em folha é vale-transporte, se não desconta é
  /// ajuda de custo. `transporteComDesconto` só é relevante quando
  /// `recebeTransporte` é true.
  recebeTransporte       Boolean  @default(false)
  valorTransporte        Decimal? @db.Decimal(10, 2)
  transporteComDesconto  Boolean  @default(false)
  /// Bonificação — não entra na base de cálculo do salário (futuros
  /// cálculos de férias/13º/rescisão devem ignorar este valor).
  recebeBonificacao          Boolean  @default(false)
  valorBonificacao           Decimal? @db.Decimal(10, 2)
  /// Prêmio de assiduidade e desempenho — mesmo espírito de bonificação
  /// (liberalidade, não entra no salário), com valor mensal de referência
  /// configurado aqui pra alimentar automaticamente o Termo de Ciência –
  /// Prêmio de Assiduidade e Desempenho gerado em /ged, sem precisar
  /// digitar o valor de novo na hora (ver TERMOS_CIENCIA_PADRAO em
  /// src/lib/ged.ts).
  recebePremioAssiduidade    Boolean  @default(false)
  valorPremioAssiduidade     Decimal? @db.Decimal(10, 2)
  /// Contrato de experiência — duração em dias de cada etapa a partir da
  /// dataAdmissao (ex.: 30+60, 45+45, ou só 90/45 numa etapa só, deixando
  /// experienciaDias2 null). Máximo legal de 90 dias somados. Ver
  /// src/lib/experiencia.ts pro cálculo das datas e do status.
  experienciaDias1       Int?
  experienciaDias2       Int?
  /// Data em que a empresa confirmou prorrogar pro 2º período da
  /// experiência — antes disso, o aviso de vencimento é sempre sobre o
  /// fim da 1ª etapa (nunca soma as duas automaticamente: são duas
  /// decisões separadas, ver calcularStatusExperiencia em
  /// src/lib/experiencia.ts). Só faz sentido quando experienciaDias2 está
  /// preenchido; null enquanto ainda não confirmou (ou não tem 2ª etapa).
  experienciaContinuouEm DateTime?           @db.Date
  /// Data em que o contrato de experiência foi efetivado (virou prazo
  /// indeterminado) — presença deste campo encerra os avisos de
  /// vencimento. Null enquanto ainda não decidido.
  experienciaEfetivadoEm DateTime?           @db.Date
  /// Data da rescisão (último dia do contrato CLT) — cobre tanto "não
  /// efetivar" no período de experiência (rescisão numa data igual ou
  /// anterior ao fim previsto, com experienciaEfetivadoEm ainda null)
  /// quanto rescisão comum de quem já foi efetivado. Null enquanto a
  /// pessoa continua empregada. Ver src/lib/rescisao.ts pro cálculo do
  /// prazo legal de pagamento/assinatura (10 dias corridos, antecipando
  /// quando cai em sábado, domingo ou feriado nacional — regra do dono,
  /// não necessariamente a única leitura possível do art. 477 §6º da CLT).
  dataRescisao               DateTime?        @db.Date
  rescisaoRegistradaEm       DateTime?
  rescisaoRegistradaPorEmail String?
  /// Turno fixo dessa pessoa — só EXTRA. Ver enum TurnoPredefinido.
  turnoPredefinido       TurnoPredefinido    @default(LIVRE)
  /// Só CLT: habilita, no totem, a pergunta "bater ponto CLT normal ou
  /// fazer um extra pago hoje" na hora da entrada. Quando a pessoa opta
  /// por extra, o turno segue o fluxo normal de EXTRA (função, contrato,
  /// cálculo de valor, pagamento) usando modoPagamento/valorDiaria/
  /// frequenciaPagamento deste mesmo vínculo — os mesmos campos que
  /// converterParaClt zera na conversão passam a ter uso de novo aqui.
  permiteExtraDiario     Boolean             @default(false)
  /// Só CLT: permite bater ponto em QUALQUER outra empresa do mesmo
  /// grupo econômico da empresa deste vínculo (ver Empresa.
  /// grupoEconomicoId) — usa a escala/horário/restrições deste vínculo
  /// (de origem), só grava o RegistroPonto na empresa visitante (ver
  /// resolverVinculoCltComGrupo em src/app/t/[token]/actions.ts).
  /// Ligado pessoa a pessoa pelo dono da empresa de origem — nunca
  /// automático só por a empresa estar no grupo.
  podeBaterPontoNoGrupo  Boolean             @default(false)
  /// Dono descartou o aviso de risco de vínculo CLT (3+ turnos numa
  /// semana sem declaração de ciência gerada) — null enquanto nunca
  /// descartou. Continua mostrando um lembrete na página da pessoa até
  /// ela gerar a declaração de verdade (ver DocumentoGed tipo
  /// TERMO_CIENCIA, termoSlug "opcao-autonomo-apos-oferta-clt") ou virar
  /// CLT — descartar não é "resolver", só "estou ciente, pare de me
  /// avisar no topo" (ver src/lib/riscoClt.ts).
  riscoCltDispensadoEm   DateTime?
  criadoEm               DateTime            @default(now())

  pessoa  Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  historicoSalarial HistoricoSalarial[]
  restricoesHorario RestricaoHorarioDia[]

  @@unique([pessoaId, empresaId])
}

/// Registra tentativas de confirmar identidade (chave PIX + segundo fator)
/// de alguém que já tem cadastro no iFREE (Pessoa é global, compartilhada
/// entre empresas) mas NUNCA teve VinculoPessoaEmpresa com esta empresa —
/// ver confirmarIdentidadeConecta em src/app/t/[token]/actions.ts. Sem
/// isso, digitar o CPF de qualquer pessoa em qualquer totem (self-service
/// em /totens) expunha telefone/endereço/chave PIX dela sem nenhuma
/// verificação. Existe só enquanto a pessoa ainda não confirmou com
/// sucesso: ao acertar, a linha é apagada e o fluxo segue normal; ao errar
/// 3x, é apagada e vira um VinculoPessoaEmpresa com `ativo=false` (mesmo
/// mecanismo de bloqueio já usado em toda a plataforma — só o responsável
/// da empresa reativa, pelo botão em /freelancers).
model TentativaConfirmacaoIdentidade {
  id           Int      @id @default(autoincrement())
  pessoaId     Int
  empresaId    Int
  tentativas   Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pessoa  Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([pessoaId, empresaId])
}

/// Restrição de horário pra bater ENTRADA no totem, por dia da semana —
/// ex.: "de segunda a sexta só libera a partir das 14h". Vale tanto pra
/// EXTRA (iniciarTurno) quanto CLT (baterPontoClt, ação ENTRADA), já que
/// mora no vínculo (o mesmo modelo que os dois tipos usam); nunca afeta
/// saída/intervalo — uma vez que a pessoa já está trabalhando, não faz
/// sentido travar ela lá dentro. Dia sem linha aqui = sem restrição
/// nenhuma nesse dia (comportamento de sempre). Ver
/// src/lib/restricao-horario.ts pra verificação/mensagem de bloqueio.
model RestricaoHorarioDia {
  id        Int @id @default(autoincrement())
  vinculoId Int
  /// 1=segunda...7=domingo — mesmo padrão ISO de diaSemanaISOBrasil
  /// (src/lib/data.ts) e Empresa.semanaPagamentoInicioDia.
  diaSemana Int
  /// Não pode bater entrada antes deste horário (minutos desde meia-noite,
  /// Brasília). Pelo menos um de horaMinimaMin/horaMaximaMin precisa estar
  /// preenchido pra linha existir (validado na camada de aplicação).
  horaMinimaMin Int?
  /// Não pode bater entrada depois deste horário — null = sem limite de fim.
  horaMaximaMin Int?

  vinculo VinculoPessoaEmpresa @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@unique([vinculoId, diaSemana])
}

/// Um registro por reajuste de salário do vínculo CLT — criado
/// automaticamente sempre que salarioMensal muda (em criarFuncionario ou
/// atualizarSalarioEscala), nunca editado manualmente nesta versão.
model HistoricoSalarial {
  id           Int      @id @default(autoincrement())
  vinculoId    Int
  valor        Decimal  @db.Decimal(10, 2)
  vigenteDesde DateTime @db.Date
  criadoEm     DateTime @default(now())

  vinculo VinculoPessoaEmpresa @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId])
}

model Funcao {
  id              Int      @id @default(autoincrement())
  empresaId       Int
  nome            String
  valorHoraPadrao Decimal  @db.Decimal(10, 2)
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  turnos  Turno[]

  @@unique([empresaId, nome])
}

model Turno {
  id                          Int                 @id @default(autoincrement())
  pessoaId                    Int
  empresaId                   Int
  totemId                     Int?
  funcaoId                    Int
  valorHoraAplicado           Decimal             @db.Decimal(10, 2)
  /// Snapshot do modo de pagamento do vínculo no momento do check-in — não
  /// muda retroativamente se o dono alterar o vínculo depois.
  modoPagamentoAplicado       ModoPagamento       @default(HORA)
  /// Snapshot do valor da diária no check-in, quando modoPagamentoAplicado
  /// é DIARIA; null quando é HORA.
  valorDiariaAplicada         Decimal?            @db.Decimal(10, 2)
  /// Snapshot da frequência de pagamento do vínculo no check-in — mesma
  /// lógica do modoPagamentoAplicado, não muda retroativamente. Usada pro
  /// relatório semanal saber quais turnos entram na conta.
  frequenciaPagamentoAplicada FrequenciaPagamento @default(DIARIA)
  horaEntrada                 DateTime
  horaSaida                   DateTime?
  minutosTrabalhados          Int?
  minutosDescontadosPausa     Int?
  minutosArredondados         Int?
  valorTotal                  Decimal?            @db.Decimal(10, 2)
  status                      StatusTurno         @default(ABERTO)
  /// true quando o cron de fechamento automático encerrou o turno (ninguém
  /// bateu saída até o corte) — sem foto/assinatura de saída, então a tela
  /// de detalhe e o recibo precisam sinalizar isso de forma diferente.
  fechamentoAutomatico        Boolean             @default(false)
  /// Ambos nulos quando o turno foi lançado manualmente pelo dono (ver
  /// criadoManualmente) — sem totem não tem como capturar foto/assinatura
  /// na hora. Sempre preenchidos quando o turno vem do totem de verdade.
  fotoEntradaUrl              String?
  fotoSaidaUrl                String?
  assinaturaContratoUrl       String?
  assinaturaReciboUrl         String?
  /// true quando o dono criou este turno direto no painel (funcionário
  /// CLT fazendo um extra pago no dia, sem passar pelo totem) — sem
  /// foto/assinatura, só o registro administrativo abaixo. Ver
  /// src/app/funcionarios/actions.ts::criarTurnoManualClt.
  criadoManualmente           Boolean             @default(false)
  criadoManualmentePorEmail   String?
  /// Auditoria de correção manual de função — preenchidos só na primeira
  /// correção (preservam o "antes" original mesmo que seja corrigido de
  /// novo depois). Null enquanto a função nunca foi corrigida.
  funcaoOriginalNome          String?
  valorHoraOriginalAplicado   Decimal?            @db.Decimal(10, 2)
  correcaoFuncaoEm            DateTime?
  correcaoFuncaoPorEmail      String?
  /// Auditoria de saída confirmada/corrigida manualmente pelo dono — dois
  /// casos usam os mesmos campos: (1) a pessoa nunca bateu saída aqui
  /// porque já apareceu com turno/ponto aberto em outra empresa (ver
  /// buscarConflitoOutroLocal em src/app/t/[token]/actions.ts), e (2) o
  /// fechamento automático encerrou com o corte padrão (fechamentoAutomatico)
  /// e o dono corrige depois pro horário real (ver corrigirSaidaTurno em
  /// src/app/turnos/actions.ts — problema técnico, esqueceu de bater etc.).
  /// Sempre a correção MAIS RECENTE; ver horaSaidaOriginal pra saber o
  /// valor antes da primeira correção.
  correcaoSaidaEm             DateTime?
  correcaoSaidaPorEmail       String?
  /// Valor de horaSaida ANTES da primeira correção manual — só preenchido
  /// na primeira vez que corrigirSaidaTurno roda num turno fechado
  /// automaticamente, preservado mesmo que seja corrigido de novo depois.
  /// Mesmo espírito de funcaoOriginalNome: mostra pro dono (e deixa
  /// auditável) o que o sistema tinha calculado sozinho vs. o horário real.
  horaSaidaOriginal           DateTime?
  /// Marcado manualmente pelo dono quando a pessoa dobrou o turno (fez dia
  /// e noite seguidos) e também esqueceu de bater saída — muda o corte do
  /// fechamento automático pro limite da noite e dobra o desconto de
  /// pausa. Ver src/lib/fechamento-automatico.ts.
  turnoDobrado                Boolean             @default(false)
  criadoEm                    DateTime            @default(now())
  atualizadoEm                DateTime            @updatedAt

  pessoa     Pessoa      @relation(fields: [pessoaId], references: [id])
  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  totem      Totem?      @relation(fields: [totemId], references: [id], onDelete: SetNull)
  funcao     Funcao      @relation(fields: [funcaoId], references: [id])
  pagamento  Pagamento?
  avaliacoes Avaliacao[]

  @@index([empresaId, status])
  @@index([pessoaId, empresaId, status])
  /// Sem isso, dashboard e /turnos (que ordenam/filtram por data, não por
  /// status) usavam (empresaId, status) como prefixo e ainda escaneavam a
  /// mais em memória pra aplicar o filtro de data — pesa mais à medida que
  /// o histórico de turnos de uma empresa cresce.
  @@index([empresaId, criadoEm])
  @@index([empresaId, horaEntrada])
}

/// Quem deu a avaliação — EXTRA é o freelancer avaliando a empresa onde
/// trabalhou, EMPRESA é o dono avaliando o freelancer. Sempre amarrada a
/// um Turno específico (não ao vínculo), porque a nota é sobre aquele
/// turno em particular.
enum AutorAvaliacao {
  EXTRA
  EMPRESA
}

/// Avaliação mútua ao encerrar um turno — base da "reputação que atravessa
/// empresas" do iFREE Conecta (ver /conecta). tags é validado em código
/// contra um vocabulário fixo por direção (src/lib/avaliacao.ts), não um
/// enum do Postgres — mais fácil de ajustar depois sem migração nova.
/// Consultada SEM filtrar por empresa quando o objetivo é reputação (ver
/// /freelancers/[id]) — de propósito, é o ponto central da ideia.
model Avaliacao {
  id       Int            @id @default(autoincrement())
  turnoId  Int
  autor    AutorAvaliacao
  nota     Int
  tags     String[]
  criadoEm DateTime       @default(now())

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@unique([turnoId, autor])
}

/// Bater ponto de funcionário CLT — controle interno de jornada, sem
/// pagamento. Modelo separado de Turno de propósito: Turno tem funcaoId,
/// valorHoraAplicado e assinaturaContratoUrl como obrigatórios, todos
/// amarrados ao fluxo de contrato/pagamento do extra, que não existe aqui.
/// NÃO é registrador eletrônico de ponto oficial (Portaria MTE 671/2021) —
/// ver disclaimer nas telas que usam este model.
model RegistroPonto {
  id                      Int                 @id @default(autoincrement())
  pessoaId                Int
  empresaId               Int
  totemId                 Int?
  horaEntrada             DateTime
  /// Só preenchido quando a empresa tem Empresa.funcionariosBaterIntervalo
  /// ligado — o totem só oferece essa opção nesse caso.
  entradaIntervalo        DateTime?
  saidaIntervalo          DateTime?
  horaSaida               DateTime?
  /// Calculado no fechamento (manual ou correção): tempo total menos a
  /// duração do intervalo, se houver. Sem arredondamento em bloco — isso é
  /// específico do cálculo de pagamento do extra (src/lib/turno.ts), não
  /// se aplica aqui.
  minutosTrabalhados      Int?
  /// Quanto de minutosTrabalhados já é o desconto automático de intervalo
  /// (Empresa.modoPausaDia/modoPausaNoite) — só entra quando a pessoa NÃO
  /// bateu um intervalo de verdade (entradaIntervalo/saidaIntervalo), que
  /// sempre tem prioridade sobre a estimativa automática. Null quando não
  /// houve desconto nenhum (jornada curta, ou modoPausa NENHUMA). Mesmo
  /// espírito de Turno.minutosDescontadosPausa, só que aqui é sempre
  /// informativo — não afeta pagamento, que não existe pro CLT.
  minutosDescontadosPausa Int?
  status                  StatusRegistroPonto @default(ABERTO)
  /// Auditoria de saída confirmada manualmente pelo dono (registro que
  /// ninguém encerrou no totem) — null quando a própria pessoa bateu a
  /// saída normalmente. Mesma lógica de Turno.correcaoSaidaEm/PorEmail,
  /// espelhada aqui pra dar a mesma visibilidade em relatório (ver
  /// /relatorios/horas): quem encerrou, a pessoa ou a empresa.
  correcaoSaidaEm         DateTime?
  correcaoSaidaPorEmail   String?
  fotoEntradaUrl          String
  fotoSaidaUrl            String?
  fotoEntradaIntervaloUrl String?
  fotoSaidaIntervaloUrl   String?
  criadoEm                DateTime            @default(now())
  atualizadoEm            DateTime            @updatedAt

  pessoa  Pessoa  @relation(fields: [pessoaId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  totem   Totem?  @relation(fields: [totemId], references: [id], onDelete: SetNull)

  @@index([empresaId, status])
  @@index([pessoaId, empresaId, status])
  /// Mesmo motivo do índice equivalente em Turno — dashboard filtra ponto
  /// CLT por horaEntrada, não por status.
  @@index([empresaId, horaEntrada])
}

model Pagamento {
  id                  Int             @id @default(autoincrement())
  turnoId             Int             @unique
  valor               Decimal         @db.Decimal(10, 2)
  chavePixDestino     String
  tipoChavePixDestino TipoChavePix    @default(CPF)
  status              StatusPagamento @default(PENDENTE)
  idTransacaoExterna  String?
  tentativas          Int             @default(0)
  erro                String?
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
  processadoEm        DateTime?
  /// true quando este pagamento foi (ou está sendo) processado pelo
  /// provedor automático (ver automatizado() em
  /// src/lib/pagamentos/processar.ts) — usado só pra exibir "Online" vs
  /// "Manual" ao lado do status na tela. Marcar como pago manualmente
  /// (ver src/app/pagamentos/actions.ts) sempre reseta pra false, mesmo
  /// que tenha havido uma tentativa automática anterior malsucedida.
  pagoAutomaticamente Boolean         @default(false)
  /// Não-nulo quando este pagamento foi confirmado junto de outros
  /// turnos da mesma pessoa numa única transferência PIX (ver
  /// GrupoPagamento) — usado pra colorir esses pagamentos com a mesma cor
  /// na tela e liberar o recibo agrupado com o detalhamento de todos.
  grupoPagamentoId    Int?

  turno          Turno           @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  grupoPagamento GrupoPagamento? @relation(fields: [grupoPagamentoId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([grupoPagamentoId])
}

enum StatusContaAsaas {
  /// Subconta criada na Asaas (POST /v3/accounts), mas a empresa ainda não
  /// terminou o onboarding/KYC que a própria Asaas manda por e-mail — não
  /// dá pra transferir nem receber enquanto está nesse estado.
  PENDENTE_ATIVACAO
  /// Onboarding concluído — subconta liberada pra operar.
  ATIVA
  /// Asaas suspendeu a subconta (ex.: documentação rejeitada, suspeita de
  /// fraude) — sinalizado pelo webhook, nunca setado por nós diretamente.
  BLOQUEADA
}

/// Subconta Asaas de UMA empresa cliente — ver
/// src/lib/pagamentos/asaas-payment-service.ts pro desenho completo do
/// fluxo (ainda não implementado, aguardando conta-mãe do iFREE na Asaas).
/// Modelo pensado pra isolar o saldo/dinheiro de cada empresa (não é uma
/// credencial única do iFREE, é uma conta por cliente) — mesmo espírito de
/// isolamento que motivaria uma ConexaoStoneEmpresa, só que a Asaas usa uma
/// API key por subconta em vez de token OAuth.
model ContaAsaasEmpresa {
  id                 Int               @id @default(autoincrement())
  empresaId          Int               @unique
  /// ID da subconta retornado pela Asaas na criação (POST /v3/accounts) —
  /// não é segredo, só um identificador.
  accountId          String            @unique
  /// Carteira da subconta (walletId) — algumas chamadas da API pedem isso
  /// em vez do accountId; guardado já de cara pra não precisar buscar de
  /// novo depois.
  walletId           String?
  /// Chave de API própria da subconta (retornada uma única vez na criação),
  /// usada em toda chamada feita EM NOME dessa empresa — nunca a chave da
  /// conta-mãe. Guardada cifrada (ver src/lib/crypto.ts); nunca logar nem
  /// devolver essa string pra tela em texto puro.
  apiKeyCriptografada String
  status             StatusContaAsaas  @default(PENDENTE_ATIVACAO)
  /// true só depois que a Asaas aprova a verificação de identidade
  /// (documento + selfie) exigida separadamente da aprovação geral da
  /// conta — sem isso a subconta não consegue receber NEM enviar Pix,
  /// mesmo já com status ATIVA. Atualizado por verificarStatusAsaas (ver
  /// src/lib/pagamentos/asaas-conta-status.ts), chamada ao vivo sempre que
  /// a empresa abre /configuracoes ou /pagamentos — não existe webhook da
  /// Asaas pra isso, por isso o valor pode ficar defasado até a próxima
  /// visita a uma dessas telas. automatizado() em
  /// src/lib/pagamentos/processar.ts exige isto true (não só a conta
  /// existir) antes de tentar qualquer PIX automático — evita transferência
  /// automática falhando em loop numa subconta ainda não liberada pra Pix.
  pixLiberado        Boolean           @default(false)
  /// ID do cliente Asaas (`POST /v3/customers`) que representa "a própria
  /// empresa depositando pra si mesma" — criado uma vez, na hora do
  /// primeiro depósito, e reaproveitado nos seguintes (evita acumular um
  /// cliente novo por depósito na conta da empresa).
  clienteProprioId   String?
  /// Preenchido quando o dono da empresa desativa deliberadamente o
  /// pagamento automático (ver desconectarContaAsaas em
  /// src/app/configuracoes/actions.ts) — null enquanto a automação está
  /// ligada. Diferente de pixLiberado (que só reflete o que a Asaas
  /// aprovou): automatizado() em src/lib/pagamentos/processar.ts exige os
  /// dois, pixLiberado true E desconectadoEm null. NÃO apaga a conexão —
  /// accountId/apiKey/walletId continuam guardados, então reconectar (ver
  /// reconectarContaAsaas) é só limpar este campo, sem precisar criar outra
  /// subconta na Asaas.
  desconectadoEm     DateTime?
  /// Quando o e-mail de "sua conta foi aprovada" foi enviado (ver
  /// verificarAprovacoesAsaasPendentes em src/lib/pagamentos/
  /// asaas-conta-status.ts, chamada pelo cron /api/cron/
  /// verificar-aprovacoes-asaas) — null enquanto não enviado. Evita
  /// reenviar toda vez que o cron rodar de novo depois de já ter avisado
  /// uma vez.
  aprovacaoNotificadaEm DateTime?
  criadoEm           DateTime          @default(now())
  atualizadoEm       DateTime          @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

enum StatusDepositoAsaas {
  PENDENTE
  RECEBIDO
  /// Venceu sem ninguém pagar — o QR code tinha validade (ver expiraEm).
  EXPIRADO
}

/// Depósito da empresa pra dentro da PRÓPRIA subconta Asaas dela — o
/// "crédito" que vai sendo usado pra pagar os extras (ver
/// src/lib/pagamentos/asaas-payment-service.ts). Mesmo espírito de
/// CobrancaMensalidade (cobrança PIX avulsa, gerada sob demanda), só que
/// o destino do dinheiro é a subconta da empresa, não a conta-mãe do
/// iFREE — e o "cliente" que paga é a própria empresa (clienteProprioId
/// em ContaAsaasEmpresa), não um terceiro.
model DepositoAsaas {
  id                Int                 @id @default(autoincrement())
  empresaId         Int
  valor             Decimal             @db.Decimal(10, 2)
  idCobrancaExterna String              @unique
  /// Copia-e-cola do PIX.
  qrCode            String?             @db.Text
  /// Imagem do QR code em base64 (data URI), já pronta pra `<img src>`.
  qrCodeImagemUrl   String?             @db.Text
  status            StatusDepositoAsaas @default(PENDENTE)
  expiraEm          DateTime
  recebidoEm        DateTime?
  criadoEm          DateTime            @default(now())
  atualizadoEm      DateTime            @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, status])
}

/// Vários turnos da MESMA pessoa pagos numa única transferência PIX,
/// confirmados juntos em /pagamentos (ver agruparEMarcarPagos) — pensado
/// pra quem recebe por semana (FrequenciaPagamento.SEMANAL) e teria que
/// somar os turnos manualmente antes de fazer um PIX só. Cada Pagamento
/// individual continua existindo e pode ser impresso separadamente (ver
/// /turnos/imprimir/recibo/pdf); este grupo só soma o valor pago de uma
/// vez e habilita o recibo consolidado (/pagamentos/grupo/[id]/recibo/pdf).
model GrupoPagamento {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  pessoaId       Int
  valorTotal     Decimal  @db.Decimal(10, 2)
  criadoPorEmail String
  criadoEm       DateTime @default(now())

  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pessoa     Pessoa      @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@index([empresaId])
  @@index([pessoaId])
}

enum StatusVaga {
  ABERTA
  PAUSADA
  ENCERRADA
}

/// Vaga publicada por uma empresa no quadro do iFREE Conecta — freelancers
/// com Pessoa.disponivelParaOportunidades ligado veem e se candidatam
/// (/portal/vagas). `cargo` é texto livre sugerido pela mesma taxonomia do
/// perfil do freelancer (CATEGORIAS_CARGOS em src/lib/habilidades.ts), sem
/// vínculo com Funcao — Funcao é escopada por empresa e só existe depois
/// que a empresa já configurou o sistema; a vaga não deveria depender disso.
model Vaga {
  id             Int        @id @default(autoincrement())
  empresaId      Int
  cargo          String
  descricao      String     @db.Text
  localizacao    String?
  /// Nome que a empresa quer mostrar pro candidato nesta vaga específica,
  /// no lugar da razão social (Empresa.nome) — útil quando a razão social
  /// não é reconhecível pra quem procura vaga. Null usa a razão social.
  nomeFantasia   String?
  /// Habilidades que a empresa procura, mesmo vocabulário do perfil do
  /// freelancer (src/lib/habilidades.ts) — usado só pro cálculo de match
  /// (src/lib/match.ts), não filtra nem restringe quem pode se candidatar.
  habilidadesProcuradas String[]   @default([])
  /// Turno(s) da vaga — pelo menos um dos dois, os dois juntos indicam que
  /// aceita qualquer horário. Backfill de vaga antiga marca os dois (não
  /// tinha essa distinção antes, então não dá pra restringir retroativo).
  turnoDia       Boolean    @default(true)
  turnoNoite     Boolean    @default(true)
  status         StatusVaga @default(ABERTA)
  criadoPorEmail String
  criadoEm       DateTime   @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  candidaturas Candidatura[]

  @@index([status])
  /// Sem isso, toda navegação do painel (layout raiz conta candidaturas
  /// pendentes via `candidatura.findMany({ where: { vaga: { empresaId } } })`)
  /// e a própria tela /vagas filtravam sem índice de apoio, escaneando
  /// mais linhas do que precisava à medida que a tabela global cresce.
  @@index([empresaId])
}

enum StatusCandidatura {
  ENVIADA
  ACEITA
  RECUSADA
}

/// Candidatura de uma Pessoa a uma Vaga — quando a empresa aceita, o
/// VinculoPessoaEmpresa é criado (upsert) automaticamente, mesmo padrão que
/// o totem já usa no primeiro check-in (ver iniciarTurno em
/// src/app/t/[token]/actions.ts), fechando o ciclo sem passo manual extra.
model Candidatura {
  id       Int               @id @default(autoincrement())
  vagaId   Int
  pessoaId Int
  status   StatusCandidatura @default(ENVIADA)
  /// Calculado uma vez no momento da candidatura (src/lib/match.ts) e
  /// congelado — não recalcula se as habilidades mudarem depois. true
  /// libera o chat entre a empresa e a pessoa (ver Conversa).
  match    Boolean           @default(false)
  criadoEm DateTime          @default(now())

  vaga   Vaga   @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  pessoa Pessoa @relation(fields: [pessoaId], references: [id])

  @@unique([vagaId, pessoaId])
}

/// Conversa entre uma Empresa e uma Pessoa — por par, não por
/// candidatura: uma vez que deu match, o chat fica valendo pra qualquer
/// vaga futura entre os dois. Criada via upsert em candidatarSe
/// (src/app/portal/vagas/actions.ts) na primeira candidatura que dá match.
model Conversa {
  id                     Int       @id @default(autoincrement())
  empresaId              Int
  pessoaId               Int
  criadaEm               DateTime  @default(now())
  /// Timestamps de última leitura de cada lado — base do indicador de
  /// "não lida" na caixa de entrada, sem precisar de flag por mensagem.
  ultimaLeituraEmpresaEm DateTime?
  ultimaLeituraPessoaEm  DateTime?

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pessoa    Pessoa     @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@unique([empresaId, pessoaId])
}

enum AutorMensagem {
  EMPRESA
  PESSOA
}

model Mensagem {
  id         Int           @id @default(autoincrement())
  conversaId Int
  autor      AutorMensagem
  /// E-mail do Usuario que mandou, só quando autor=EMPRESA — várias
  /// pessoas da empresa podem ter acesso ao mesmo login/painel.
  autorEmail String?
  texto      String        @db.Text
  criadoEm   DateTime      @default(now())

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, criadoEm])
}

enum CategoriaDenuncia {
  ASSEDIO_MORAL
  ASSEDIO_SEXUAL
  DISCRIMINACAO
  RISCO_PSICOSSOCIAL
  SEGURANCA_TRABALHO
  CORRUPCAO_FRAUDE
  CONFLITO_INTERESSES
  DESCUMPRIMENTO_NORMAS
  RETALIACAO
  OUTROS
}

enum GravidadeDenuncia {
  BAIXA
  MEDIA
  ALTA
}

enum StatusDenuncia {
  RECEBIDO
  TRIAGEM
  EM_INVESTIGACAO
  AGUARDANDO_INFORMACOES
  PARECER_EMITIDO
  PROVIDENCIAS
  FINALIZADO
}

enum AutorMensagemDenuncia {
  EMPRESA
  DENUNCIANTE
}

/// Canal de Denúncias / Central de Ética (NR-1) — denúncia pode ser
/// anônima (identificado=false, pessoaId null, acesso por protocolo+senha)
/// ou identificada via login do Portal (identificado=true, pessoaId
/// setado, sem senha própria — a autenticação já é a sessão da Pessoa).
/// Gravidade é preenchida manualmente pela empresa por enquanto (sem IA).
model Denuncia {
  id           Int                @id @default(autoincrement())
  empresaId    Int
  protocolo    String             @unique
  /// Hash bcrypt (nunca texto puro) — null quando identificado=true, já
  /// que nesse caso o acesso é pela sessão do Portal, não por senha.
  senhaHash    String?
  identificado Boolean            @default(false)
  pessoaId     Int?
  categoria    CategoriaDenuncia
  descricao    String             @db.Text
  gravidade    GravidadeDenuncia?
  status       StatusDenuncia     @default(RECEBIDO)
  prazoSlaEm   DateTime
  finalizadoEm DateTime?
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt

  empresa        Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pessoa         Pessoa?                @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  mensagens      MensagemDenuncia[]
  etapas         EtapaDenuncia[]
  logs           LogAuditoriaDenuncia[]
  sessoesAnonimas SessaoDenunciaAnonima[]

  @@index([empresaId, status])
}

model MensagemDenuncia {
  id         Int                   @id @default(autoincrement())
  denunciaId Int
  autor      AutorMensagemDenuncia
  /// E-mail do Usuario que mandou, só quando autor=EMPRESA.
  autorEmail String?
  texto      String                @db.Text
  criadoEm   DateTime              @default(now())

  denuncia Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)

  @@index([denunciaId, criadoEm])
}

/// Histórico de mudança de etapa — a linha do tempo mostrada no caso e no
/// PDF de comprovação. A primeira linha (RECEBIDO) é criada automaticamente
/// junto com a denúncia, com autorEmail null.
model EtapaDenuncia {
  id         Int            @id @default(autoincrement())
  denunciaId Int
  status     StatusDenuncia
  observacao String?        @db.Text
  autorEmail String?
  criadoEm   DateTime       @default(now())

  denuncia Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)

  @@index([denunciaId])
}

/// Log de auditoria — toda ação estrutural (criação, mudança de etapa,
/// definição de gravidade, acesso via protocolo) fica registrada aqui,
/// separado do histórico de etapas e das mensagens do chat, pra dar um
/// rastro completo de auditoria/conformidade.
model LogAuditoriaDenuncia {
  id         Int      @id @default(autoincrement())
  denunciaId Int
  acao       String
  detalhe    String?  @db.Text
  autorEmail String?
  criadoEm   DateTime @default(now())

  denuncia Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)

  @@index([denunciaId, criadoEm])
}

enum TipoDocumentoGed {
  ADVERTENCIA
  SUSPENSAO
  CONTRATO_TRABALHO
  /// Termo de ciência genérico (campanhas de saúde, monitoramento etc.)
  /// — texto fixo por lei/norma, catálogo em TERMOS_CIENCIA_PADRAO
  /// (src/lib/ged.ts), um `tipo` só pra todos, distinguidos pelo
  /// `termoSlug` guardado em snapshotDados. Cada termo novo é só um
  /// item a mais nesse array, sem precisar de outro valor de enum.
  TERMO_CIENCIA
}

/// Log unificado de documentos "carta" gerados pelo GED — advertência,
/// suspensão e contrato de trabalho CLT são a mesma forma (modelo de
/// texto + dados da pessoa/empresa no momento + uma data → PDF pra
/// imprimir e assinar fisicamente), uma tabela só evita triplicar
/// schema e renderer. Ficha de EPI (EntradaEpi) e regulamento interno
/// (Empresa.regulamentoInterno) NÃO entram aqui de propósito — são
/// formas diferentes (lista contínua a primeira, documento único da
/// empresa a segunda).
model DocumentoGed {
  id            Int              @id @default(autoincrement())
  empresaId     Int
  pessoaId      Int
  tipo          TipoDocumentoGed
  /// Id do ModeloDocumentoGed usado na geração — null se o modelo foi
  /// apagado depois (nunca quebra a leitura do histórico: o texto já
  /// está congelado em corpoTexto).
  modeloId      Int?
  /// Nome do modelo no momento da geração (cópia, não FK) — aparece no
  /// histórico mesmo se o ModeloDocumentoGed for apagado depois.
  modeloNome    String
  /// Texto final (modelo já resolvido) que foi de fato impresso —
  /// congelado na geração, nunca recalculado.
  corpoTexto    String           @db.Text
  /// Data escolhida no formulário (data da advertência/suspensão/início
  /// do contrato) — default hoje, editável pelo admin.
  dataDocumento DateTime         @db.Date
  /// Congela nome completo, CPF, dados da CTPS, cargo etc. no momento da
  /// geração — ver montarSnapshotPessoa em src/lib/ged.ts. Garante que
  /// reabrir um PDF antigo mostra os dados de QUANDO foi gerado, mesmo
  /// que a pessoa corrija CTPS/cargo depois.
  snapshotDados Json
  geradoPorEmail String
  geradoEm       DateTime        @default(now())
  /// Presença = documento já tem o scan da via assinada fisicamente
  /// anexado — mesmo idioma de Turno.assinaturaContratoUrl (URL nullable
  /// como sinal, sem enum de status separado).
  arquivoAssinadoUrl      String?
  arquivoAssinadoEm       DateTime?
  arquivoAssinadoPorEmail String?

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pessoa  Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([empresaId, pessoaId])
}

/// Modelo nomeado e reutilizável de advertência/suspensão — diferente de
/// Empresa.termosContrato/contratoCltTermos (um texto só por empresa):
/// aqui a empresa pode ter VÁRIOS modelos, escolhidos na hora de gerar o
/// documento. Sem linha padrão pré-criada no banco — o fallback do
/// sistema (MODELOS_PADRAO_ADVERTENCIA/SUSPENSAO em src/lib/ged.ts) é só
/// código, mostrado no seletor quando a empresa ainda não criou nenhum
/// modelo próprio daquele tipo (mesma filosofia de TERMOS_CONTRATO).
model ModeloDocumentoGed {
  id         Int              @id @default(autoincrement())
  empresaId  Int
  tipo       TipoDocumentoGed
  nome       String
  corpoTexto String           @db.Text
  ativo      Boolean          @default(true)
  criadoEm   DateTime         @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, tipo])
}

/// Uma linha da ficha de controle de entrega de EPI — item entregue, em
/// que quantidade, em que data. Continua acumulando ao longo do tempo
/// pra uma mesma pessoa (diferente de DocumentoGed, que é "um documento
/// por evento"); o PDF da ficha lista todas as linhas da pessoa numa
/// tabela consolidada, gerado sob demanda sem "congelar" nada — sempre
/// reflete as entregas registradas até o momento da impressão.
model EntradaEpi {
  id                 Int      @id @default(autoincrement())
  empresaId          Int
  pessoaId           Int
  item               String
  quantidade         Int      @default(1)
  /// Número do Certificado de Aprovação do EPI — impresso na ficha
  /// (coluna "C.A"), não validado pelo sistema.
  numeroCA           String?
  /// Valor unitário do item — impresso na ficha só como referência (pra
  /// a empresa saber quanto descontar na rescisão se o EPI não for
  /// devolvido); o iFREE não calcula nem aplica nenhum desconto sozinho.
  valorUnitario      Decimal? @db.Decimal(10, 2)
  dataEntrega        DateTime @db.Date
  observacao         String?
  registradoPorEmail String
  criadoEm           DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pessoa  Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([empresaId, pessoaId])
}

/// Biblioteca de modelos de papel PRÓPRIOS de uma empresa (upload de um
/// PDF/imagem que ela já usa) — os modelos padrão do sistema (limpeza de
/// caixa de gordura, troca de óleo etc.) NÃO ficam aqui: são só um array
/// TypeScript fixo (MODELOS_PADRAO_PAPEL em src/lib/ged.ts) renderizado
/// por um gerador de PDF genérico, sem necessidade de linha no banco.
/// Esta tabela é só pro que a empresa manda pelo upload.
model ModeloPapelGed {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  nome           String
  arquivoUrl     String
  contentType    String
  criadoPorEmail String
  criadoEm       DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

/// Sessão leve criada depois de conferir protocolo+senha corretamente —
/// só pra permitir o polling do chat sem pedir a senha de novo a cada
/// alguns segundos. Mesmo espírito de Sessao/SessaoPessoa, só que de vida
/// curta e sem dado nenhum de identidade (a "identidade" aqui é só o
/// acesso àquela denúncia específica).
model SessaoDenunciaAnonima {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  denunciaId Int
  expiraEm   DateTime
  criadoEm   DateTime @default(now())

  denuncia Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
}

// --- PGR (riscos psicossociais, NR-1) ---

enum StatusCicloPgr {
  ABERTO
  ENCERRADO
}

/// Uma rodada da pesquisa anônima de riscos psicossociais — a NR-1 exige
/// reavaliação completa no mínimo anual, então cada ciclo representa uma
/// dessas rodadas (abre, coleta respostas pelo link público, encerra e
/// congela a matriz de risco daquele momento).
model CicloPgr {
  id          Int            @id @default(autoincrement())
  empresaId   Int
  status      StatusCicloPgr @default(ABERTO)
  abertoEm    DateTime       @default(now())
  encerradoEm DateTime?

  empresa   Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  respostas RespostaPgr[]

  @@index([empresaId, status])
}

/// Uma resposta anônima à pesquisa — sem pessoaId de propósito (não dá
/// pra reidentificar quem respondeu; ver criarRespostaPgrPublica em
/// src/lib/pgr.ts). cargo é opcional e congelado aqui como texto livre
/// no momento da resposta, pra sobreviver a uma renomeação de cargo
/// depois sem corromper o histórico da rodada.
model RespostaPgr {
  id       Int    @id @default(autoincrement())
  cicloId  Int
  cargo    String?
  /// { [idPergunta]: valorLikert (1-5) } — perguntas vêm de
  /// src/lib/pgr-questionario.ts (fixas no código), não do banco.
  respostas Json
  criadoEm DateTime @default(now())

  ciclo CicloPgr @relation(fields: [cicloId], references: [id], onDelete: Cascade)
}

enum StatusAcaoPgr {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

/// Item do plano de ação do PGR — uma medida pra tratar um risco
/// identificado na matriz. Vinculado à empresa (não a um ciclo
/// específico), já que uma ação pode continuar em andamento entre
/// ciclos.
model AcaoPgr {
  id             Int           @id @default(autoincrement())
  empresaId      Int
  dimensao       String
  descricaoRisco String        @db.Text
  medida         String        @db.Text
  responsavel    String?
  prazo          DateTime?     @db.Date
  status         StatusAcaoPgr @default(PENDENTE)
  concluidoEm    DateTime?
  criadoEm       DateTime      @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}
